# =============================================================================
# Environment Variables Reference
# =============================================================================
# Copy this file to .env.local and fill in the actual values for your environment.
# Variables prefixed with VITE_ are exposed to the browser; keep others private.
#
# Quick start:
#   1. cp .env.example .env.local
#   2. docker-compose up -d   (starts local Postgres)
#   3. pnpm install
#   4. pnpm test              (tests run against local Postgres)
#   5. pnpm dev               (runs dev server)
# =============================================================================

# ─ Database (required for server to run)
# For production: use your Supabase DATABASE_URL
# For development: docker-compose starts a local Postgres at postgresql://user:password@localhost:5432/store
DATABASE_URL=postgresql://user:password@localhost:5432/store

# ─ Authentication & Sessions (required)
# Generate a secure 32+ character random string and paste here
# On macOS/Linux: openssl rand -hex 32
JWT_SECRET=your-secure-random-jwt-secret-here-min-32-chars

# ─ Supabase Configuration (required if using Supabase auth)
# Get these from your Supabase project settings (API tab)
VITE_SUPABASE_URL=https://your-project.supabase.co/rest/v1/
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ─ OAuth / SSO (optional, required only if using external OAuth)
VITE_APP_ID=your-app-id
VITE_OAUTH_PORTAL_URL=https://oauth.example.com
VITE_SUPABASE_OAUTH_REDIRECT_URL=/auth/callback
OAUTH_SERVER_URL=https://oauth-server.example.com
OWNER_OPEN_ID=your-owner-open-id

# ─ Paystack Payment Gateway (required if using Paystack)
# Get these from your Paystack Dashboard
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your-public-key
PAYSTACK_SECRET_KEY=sk_live_your-secret-key

# ─ Stripe Payment Gateway (required if using Stripe)
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Use sk_test_/whsec_test_ keys for local development, sk_live_ only in production.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
# From https://dashboard.stripe.com/webhooks, or `stripe listen --forward-to localhost:3001/api/webhooks/stripe` locally
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ─ Email Configuration (SMTP, required for transactional emails)
# Example: Gmail App Password setup
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=noreply@example.com
SENDER_NAME=Your Store Name

# ─ External APIs / Third-party Services (optional)
# Currency conversion API
VITE_CURRENCY_API_KEY=your-currency-api-key

# Geolocation API
VITE_GEOLOCATION_API_KEY=your-geolocation-api-key

# Google reCAPTCHA (optional, used for contact form protection)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# VIN decoder / automotive data APIs (optional)
BUILT_IN_FORGE_API_URL=https://forge-api.example.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key
VITE_FRONTEND_FORGE_API_URL=https://forge-proxy.example.com
VITE_FRONTEND_FORGE_API_KEY=your-forge-proxy-key

# ─ Analytics (optional)
# Google Analytics 4 measurement ID
VITE_GA_ID=G-XXXXXXXXXX

# ─ Site Configuration
# Primary domain and app URLs
VITE_APP_URL=https://motorvault.shop
VITE_SITE_URL=https://motorvault.shop

# ─ Runtime Environment
# Don't change these unless you know what you're doing
NODE_ENV=development
PORT=3001
VERCEL=0

# ─ Feature Flags & Debugging (optional)
# Fast build for development (skips optimization)
FAST_BUILD=0

# Legacy/Deprecated (these still work but are superseded by new names):
# COOKIE_SECRET → use JWT_SECRET
# GMAIL_USER → use SMTP_USER
